<% page_title "Chi tiết dự án" %>
<%= render "projects/header" %>
<div class="mt-4 x-card overflow-hidden">
  <div class="x-card-head">
    <h2 class="x-h3 x-section-title">Hoạt động của dự án</h2>
    <span class="x-muted"><%= number_with_delimiter(@pagy.total_count, delimiter: ".") %> thao tác</span>
  </div>
  <%= render "shared/activity_list", activities: @activities %>
  <%= render "shared/pagination", paginator: @pagy, unit: "thao tác" %>
</div>
