<% page_title "Cây định hướng mới" %>
<div class="max-w-[520px]">
  <div class="x-card">
    <div class="x-card-head"><h2 class="x-h3">Tạo cây định hướng mới</h2></div>
    <div class="p-5">
      <%= form_with model: @tree, url: strategy_trees_path, local: true do |f| %>
        <div class="x-field">
          <label>Tên cây</label>
          <%= f.text_field :name, class: "x-input", autofocus: true, placeholder: "Định hướng 2027" %>
        </div>
        <div class="x-field">
          <label>Mô tả</label>
          <%= f.text_area :description, class: "x-textarea", rows: 2 %>
        </div>
        <div class="x-field">
          <label>Bắt đầu từ</label>
          <select name="template" class="x-select">
            <option value="blank">Cây trống</option>
            <option value="year">Mẫu định hướng năm (4 mảng)</option>
            <option value="product">Mẫu cây sản phẩm</option>
          </select>
        </div>
        <button class="x-btn x-btn-primary">Tạo cây</button>
      <% end %>
    </div>
  </div>
</div>
