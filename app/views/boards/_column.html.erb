<div class="x-col" data-column-id="<%= column.id %>">
  <div class="x-col-head">
    <i class="w-2 h-2 rounded-full flex-none" style="background:<%= column.color.presence || '#6B7A8F' %>"></i>
    <span class="font-semibold text-[13.5px] flex-1 truncate"><%= column.name %></span>
    <span class="x-num text-[12px] font-semibold px-1.5 py-0.5 rounded-md
                 <%= 'x-chip-bad' if column.over_wip? %>"
          style="<%= column.over_wip? ? 'background:var(--bad-soft);color:var(--bad)' : 'color:var(--ink-3)' %>">
      <%= tasks.size %><%= " / #{column.wip_limit}" if column.wip_limit %>
    </span>

    <div class="relative" data-controller="dropdown">
      <button class="w-6 h-6 rounded-md grid place-items-center hover:bg-white text-[13px]"
              style="color:var(--ink-3)" data-action="dropdown#toggle" aria-label="Tuỳ chọn cột">⋯</button>
      <div class="absolute right-0 mt-1.5 w-[248px] x-card p-3 z-50" hidden data-dropdown-target="menu">
        <%= form_with url: project_board_column_path(@project, column), method: :patch, class: "space-y-2.5" do %>
          <div>
            <label class="x-label block mb-1">Tên cột</label>
            <input type="text" name="board_column[name]" value="<%= column.name %>" class="x-input h-9 text-[13px]">
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1">
              <label class="x-label block mb-1">Giới hạn WIP</label>
              <input type="number" name="board_column[wip_limit]" value="<%= column.wip_limit %>" min="0"
                     placeholder="không giới hạn" class="x-input h-9 text-[13px]">
            </div>
            <div>
              <label class="x-label block mb-1">Màu</label>
              <input type="color" name="board_column[color]" value="<%= column.color.presence || '#6B7A8F' %>"
                     class="h-9 w-[44px] rounded-[9px] border cursor-pointer" style="border-color:var(--line)">
            </div>
          </div>
          <label class="flex items-center gap-2 text-[12.5px] cursor-pointer">
            <input type="hidden" name="board_column[is_done_column]" value="0">
            <input type="checkbox" name="board_column[is_done_column]" value="1" class="x-check" <%= "checked" if column.is_done_column? %>>
            Cột này tính là “Hoàn thành”
          </label>
          <button class="x-btn x-btn-primary x-btn-sm x-btn-block">Lưu cột</button>
        <% end %>
        <div class="x-divider my-2.5"></div>
        <%= button_to "Xoá cột", project_board_column_path(@project, column), method: :delete,
                      form: { data: { turbo_confirm: "Xoá cột “#{column.name}”? Công việc bên trong sẽ chuyển sang cột đầu tiên." } },
                      class: "w-full x-btn x-btn-sm x-btn-block", style: "color:var(--bad);background:var(--bad-soft)" %>
      </div>
    </div>

    <button class="w-6 h-6 rounded-md grid place-items-center hover:bg-white text-[15px] leading-none"
            style="color:var(--ink-3)" data-action="kanban#openComposer" data-column-id="<%= column.id %>" aria-label="Thêm công việc">+</button>
  </div>

  <div class="x-col-body" data-kanban-target="list" data-column-id="<%= column.id %>">
    <% tasks.each do |task| %>
      <%= render "tasks/card", task: task %>
    <% end %>
  </div>

  <div class="px-2.5 pb-2.5">
    <%= form_with url: project_tasks_path(@project), method: :post, class: "hidden" ,
                  data: { kanban_target: "composer", column_id: column.id } do %>
      <%= hidden_field_tag "task[board_column_id]", column.id %>
      <input type="text" name="task[title]" placeholder="Tiêu đề công việc…"
             class="x-input h-9 text-[13px] mb-2" data-kanban-target="composerInput">
      <div class="flex gap-2">
        <button class="x-btn x-btn-primary x-btn-sm flex-1">Thêm</button>
        <button type="button" class="x-btn x-btn-ghost x-btn-sm" data-action="kanban#closeComposer">Huỷ</button>
      </div>
    <% end %>
    <button class="w-full text-left px-2.5 py-2 rounded-lg text-[13px] font-medium hover:bg-white transition"
            style="color:var(--ink-3)" data-action="kanban#openComposer" data-column-id="<%= column.id %>">
      + Thêm công việc
    </button>
  </div>
</div>
