<% page_title "Sản phẩm #{@project.code}" %>
<%= render "projects/header" %>

<div class="mt-4 space-y-4">
  <%# --- Mô tả sản phẩm ------------------------------------------------- %>
  <div class="x-card">
    <div class="x-card-head">
      <h2 class="x-h3 x-section-title">Mô tả sản phẩm</h2>
      <span class="x-muted">Sản phẩm này là gì, giải quyết việc gì, cho ai</span>
    </div>
    <div class="p-5">
      <%= form_with model: @project, url: project_path(@project), method: :patch, local: true do |f| %>
        <%= return_to_field %>
        <div class="x-editor">
          <%= f.rich_text_area :product_brief,
                               placeholder: "Sản phẩm giải quyết vấn đề gì · Điểm khác biệt · Trạng thái hiện tại · Kế hoạch sắp tới…" %>
        </div>
        <%= f.submit "Lưu mô tả", class: "x-btn x-btn-primary x-btn-sm cursor-pointer mt-3" %>
      <% end %>
    </div>
  </div>

  <%# --- Tài liệu ----------------------------------------------------- %>
  <div class="x-card">
    <div class="x-card-head">
      <h2 class="x-h3 x-section-title x-section-title-good">Tài liệu</h2>
      <span class="x-muted"><%= @docs.size %> mục</span>
      <%= link_to "+ Viết tài liệu", new_project_project_resource_path(@project),
                  class: "x-btn x-btn-primary x-btn-sm ml-auto flex-none" %>
    </div>
    <div class="p-4">
      <% if @docs.empty? %>
        <p class="x-muted mb-3">
          Chưa có tài liệu nào. Viết thẳng trong app bằng Markdown/HTML, hoặc tải
          lên đặc tả, hợp đồng, bản trình bày…
        </p>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 mb-3">
          <% @docs.each do |item| %>
            <%# Mở được trong app thì vào trang đọc; tệp .pdf, .docx… thì tải về. %>
            <% target = item.viewable? ? project_project_resource_path(@project, item)
                                       : rails_blob_path(item.file, disposition: "attachment") %>
            <div class="flex items-start gap-2.5 px-3 py-2.5 rounded-[10px] border group" style="border-color:var(--line)">
              <span class="w-7 h-7 rounded-lg grid place-items-center flex-none mt-0.5"
                    style="background:<%= item.written? ? 'var(--good-soft)' : 'var(--bg)' %>">
                <% if item.written? %>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--good)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.2 2.6l2.2 2.2-7.4 7.4-2.9.7.7-2.9z"/>
                  </svg>
                <% else %>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--ink-3)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 1.8H4.4a1.2 1.2 0 00-1.2 1.2v10a1.2 1.2 0 001.2 1.2h7.2a1.2 1.2 0 001.2-1.2V5.6z"/>
                    <path d="M9 1.8v3.8h3.8"/>
                  </svg>
                <% end %>
              </span>

              <div class="min-w-0 flex-1">
                <%= link_to item.label, target,
                            class: "block text-[13px] font-medium truncate hover:underline",
                            **(item.viewable? ? {} : { target: "_blank", rel: "noopener" }) %>
                <div class="x-muted truncate">
                  <% if item.written? %>
                    <%= item.content_format.to_s.upcase %> · <%= time_ago(item.updated_at) %>
                  <% else %>
                    <%= item.file.filename.extension.to_s.upcase %> ·
                    <%= number_to_human_size(item.file.byte_size) %> · <%= time_ago(item.created_at) %>
                  <% end %>
                </div>
                <% if item.excerpt.present? %>
                  <div class="x-muted mt-0.5 line-clamp-2 leading-snug"><%= item.excerpt %></div>
                <% end %>
              </div>

              <%= button_to "×", project_project_resource_path(@project, item), method: :delete,
                            form: { data: { turbo_confirm: "Xoá tài liệu “#{item.label}”?" } },
                            class: "w-6 h-6 rounded-md opacity-0 group-hover:opacity-100 text-[15px] flex-none hover:bg-[var(--bad-soft)]",
                            style: "color:var(--ink-3)" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= form_with url: project_project_resources_path(@project), method: :post, multipart: true,
                    class: "flex flex-wrap items-center gap-2 pt-3 border-t" do %>
        <%= hidden_field_tag "project_resource[kind]", "doc" %>
        <span class="x-eyebrow flex-none">Tải tệp lên</span>
        <input type="text" name="project_resource[label]" placeholder="Tên tài liệu" class="x-input h-9 text-[13px] w-[220px]" required>
        <%= vn_file_field_tag("project_resource[file]", button_label: "Chọn tệp…") %>
        <%# Nút kết thúc hành động: để primary cho tách hẳn khỏi nút "Chọn tệp…"
            dạng viền, nếu không hai nút trông như nhau và không rõ bấm cái nào. %>
        <button class="x-btn x-btn-primary flex-none">↑ Tải lên</button>
      <% end %>
      <p class="x-hint mt-2">
        Tệp lưu trên DigitalOcean Spaces, tối đa 25MB mỗi tệp. Tệp
        <code>.md</code>, <code>.html</code>, <code>.txt</code> đọc được ngay
        trong app, không cần tải về.
      </p>
    </div>
  </div>
</div>
