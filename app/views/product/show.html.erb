<% page_title "Sản phẩm #{@project.code}" %>
<%= render "projects/header" %>

<div class="mt-4 space-y-4">
  <%# --- Mô tả sản phẩm ------------------------------------------------- %>
  <div class="x-card">
    <div class="x-card-head">
      <h2 class="x-h3 x-section-title">Mô tả sản phẩm</h2>
      <span class="x-muted">Sản phẩm này là gì, giải quyết việc gì, cho ai</span>
    </div>
    <div class="p-5">
      <%= form_with model: @project, url: project_path(@project), method: :patch, local: true do |f| %>
        <div class="x-editor">
          <%= f.rich_text_area :product_brief,
                               placeholder: "Sản phẩm giải quyết vấn đề gì · Điểm khác biệt · Trạng thái hiện tại · Kế hoạch sắp tới…" %>
        </div>
        <%= f.submit "Lưu mô tả", class: "x-btn x-btn-primary x-btn-sm cursor-pointer mt-3" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 items-start">
    <%# --- Liên kết --------------------------------------------------- %>
    <div class="x-card">
      <div class="x-card-head">
        <h2 class="x-h3 x-section-title">Liên kết</h2>
        <span class="x-muted"><%= @links.size %></span>
      </div>
      <div class="p-4">
        <% if @links.empty? %>
          <p class="x-muted mb-3">Chưa có liên kết nào. Thêm trang sản phẩm, kho mã, bảng thiết kế…</p>
        <% else %>
          <div class="space-y-1 mb-3">
            <% @links.each do |item| %>
              <div class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg hover:bg-[var(--bg)] group">
                <span class="w-7 h-7 rounded-lg grid place-items-center flex-none" style="background:var(--brand-soft)">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--brand)" stroke-width="1.6" stroke-linecap="round">
                    <path d="M6.5 9.5a2.8 2.8 0 004 0l2.2-2.2a2.8 2.8 0 10-4-4l-.6.6"/>
                    <path d="M9.5 6.5a2.8 2.8 0 00-4 0L3.3 8.7a2.8 2.8 0 104 4l.6-.6"/>
                  </svg>
                </span>
                <div class="min-w-0 flex-1">
                  <%= link_to item.label, item.url, target: "_blank", rel: "noopener noreferrer",
                              class: "block text-[13.5px] font-medium truncate hover:underline" %>
                  <div class="x-muted truncate"><%= item.display_host || item.url %><%= " · #{item.note}" if item.note.present? %></div>
                </div>
                <%= button_to "×", project_project_resource_path(@project, item), method: :delete,
                              form: { data: { turbo_confirm: "Xoá liên kết “#{item.label}”?" } },
                              class: "w-6 h-6 rounded-md opacity-0 group-hover:opacity-100 text-[15px] flex-none hover:bg-[var(--bad-soft)]",
                              style: "color:var(--ink-3)" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= form_with url: project_project_resources_path(@project), method: :post, class: "space-y-2" do %>
          <%= hidden_field_tag "project_resource[kind]", "link" %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" name="project_resource[label]" placeholder="Tên (Trang chủ, Kho mã…)" class="x-input h-9 text-[13px]" required>
            <input type="text" name="project_resource[url]" placeholder="xstudio.vn hoặc https://…" class="x-input h-9 text-[13px]" required>
          </div>
          <div class="flex gap-2">
            <input type="text" name="project_resource[note]" placeholder="Ghi chú (tuỳ chọn)" class="x-input h-9 text-[13px]">
            <button class="x-btn x-btn-ghost x-btn-sm flex-none">Thêm</button>
          </div>
        <% end %>
      </div>
    </div>

    <%# --- Tài khoản truy cập ------------------------------------------ %>
    <div class="x-card">
      <div class="x-card-head">
        <h2 class="x-h3 x-section-title x-section-title-warn">Tài khoản truy cập</h2>
        <span class="x-muted"><%= @accounts.size %></span>
      </div>
      <div class="p-4">
        <div class="x-toast x-toast-warn mb-3 text-[12.5px]">
          Đây là nơi ghi <strong>dùng tài khoản nào</strong> để vào từng dịch vụ.
          Mật khẩu để ở trình quản lý mật khẩu, đừng ghi vào đây.
        </div>

        <% if @accounts.empty? %>
          <p class="x-muted mb-3">Chưa ghi tài khoản nào.</p>
        <% else %>
          <div class="space-y-1 mb-3">
            <% @accounts.each do |item| %>
              <div class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg hover:bg-[var(--bg)] group">
                <span class="w-7 h-7 rounded-lg grid place-items-center flex-none" style="background:var(--warn-soft)">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--warn)" stroke-width="1.6" stroke-linecap="round">
                    <circle cx="8" cy="5.5" r="2.6"/><path d="M3 13.5c0-2.6 2.2-4 5-4s5 1.4 5 4"/>
                  </svg>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="text-[13.5px] font-medium truncate">
                    <%= item.label %>
                    <% if item.url.present? %>
                      <%= link_to "↗", item.url, target: "_blank", rel: "noopener noreferrer",
                                  class: "ml-1 text-[12px]", style: "color:var(--brand)", title: item.url %>
                    <% end %>
                  </div>
                  <div class="x-muted truncate">
                    <%= item.username.presence || "chưa ghi tài khoản" %><%= " · #{item.note}" if item.note.present? %>
                  </div>
                </div>
                <%= button_to "×", project_project_resource_path(@project, item), method: :delete,
                              form: { data: { turbo_confirm: "Xoá “#{item.label}”?" } },
                              class: "w-6 h-6 rounded-md opacity-0 group-hover:opacity-100 text-[15px] flex-none hover:bg-[var(--bad-soft)]",
                              style: "color:var(--ink-3)" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= form_with url: project_project_resources_path(@project), method: :post, class: "space-y-2" do %>
          <%= hidden_field_tag "project_resource[kind]", "account" %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" name="project_resource[label]" placeholder="Dịch vụ (Google Analytics…)" class="x-input h-9 text-[13px]" required>
            <input type="text" name="project_resource[username]" placeholder="Tài khoản đăng nhập" class="x-input h-9 text-[13px]">
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" name="project_resource[url]" placeholder="Đường dẫn đăng nhập (tuỳ chọn)" class="x-input h-9 text-[13px]">
            <div class="flex gap-2">
              <input type="text" name="project_resource[note]" placeholder="Ghi chú" class="x-input h-9 text-[13px]">
              <button class="x-btn x-btn-ghost x-btn-sm flex-none">Thêm</button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# --- Tài liệu ----------------------------------------------------- %>
  <div class="x-card">
    <div class="x-card-head">
      <h2 class="x-h3 x-section-title x-section-title-good">Tài liệu</h2>
      <span class="x-muted"><%= @docs.size %> mục</span>
      <%= link_to "+ Viết tài liệu", new_project_project_resource_path(@project),
                  class: "x-btn x-btn-primary x-btn-sm ml-auto flex-none" %>
    </div>
    <div class="p-4">
      <% if @docs.empty? %>
        <p class="x-muted mb-3">
          Chưa có tài liệu nào. Viết thẳng trong app bằng Markdown/HTML, hoặc tải
          lên đặc tả, hợp đồng, bản trình bày…
        </p>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 mb-3">
          <% @docs.each do |item| %>
            <%# Mở được trong app thì vào trang đọc; tệp .pdf, .docx… thì tải về. %>
            <% target = item.viewable? ? project_project_resource_path(@project, item)
                                       : rails_blob_path(item.file, disposition: "attachment") %>
            <div class="flex items-start gap-2.5 px-3 py-2.5 rounded-[10px] border group" style="border-color:var(--line)">
              <span class="w-7 h-7 rounded-lg grid place-items-center flex-none mt-0.5"
                    style="background:<%= item.written? ? 'var(--good-soft)' : 'var(--bg)' %>">
                <% if item.written? %>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--good)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.2 2.6l2.2 2.2-7.4 7.4-2.9.7.7-2.9z"/>
                  </svg>
                <% else %>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--ink-3)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 1.8H4.4a1.2 1.2 0 00-1.2 1.2v10a1.2 1.2 0 001.2 1.2h7.2a1.2 1.2 0 001.2-1.2V5.6z"/>
                    <path d="M9 1.8v3.8h3.8"/>
                  </svg>
                <% end %>
              </span>

              <div class="min-w-0 flex-1">
                <%= link_to item.label, target,
                            class: "block text-[13px] font-medium truncate hover:underline",
                            **(item.viewable? ? {} : { target: "_blank", rel: "noopener" }) %>
                <div class="x-muted truncate">
                  <% if item.written? %>
                    <%= item.content_format.to_s.upcase %> · <%= time_ago(item.updated_at) %>
                  <% else %>
                    <%= item.file.filename.extension.to_s.upcase %> ·
                    <%= number_to_human_size(item.file.byte_size) %> · <%= time_ago(item.created_at) %>
                  <% end %>
                </div>
                <% if item.excerpt.present? %>
                  <div class="x-muted mt-0.5 line-clamp-2 leading-snug"><%= item.excerpt %></div>
                <% end %>
              </div>

              <%= button_to "×", project_project_resource_path(@project, item), method: :delete,
                            form: { data: { turbo_confirm: "Xoá tài liệu “#{item.label}”?" } },
                            class: "w-6 h-6 rounded-md opacity-0 group-hover:opacity-100 text-[15px] flex-none hover:bg-[var(--bad-soft)]",
                            style: "color:var(--ink-3)" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= form_with url: project_project_resources_path(@project), method: :post, multipart: true,
                    class: "flex flex-wrap items-center gap-2 pt-3 border-t" do %>
        <%= hidden_field_tag "project_resource[kind]", "doc" %>
        <span class="x-eyebrow flex-none">Tải tệp lên</span>
        <input type="text" name="project_resource[label]" placeholder="Tên tài liệu" class="x-input h-9 text-[13px] w-[220px]" required>
        <%= vn_file_field_tag("project_resource[file]", button_label: "Chọn tệp…") %>
        <button class="x-btn x-btn-ghost x-btn-sm">Tải lên</button>
      <% end %>
      <p class="x-hint mt-2">
        Tệp lưu trên DigitalOcean Spaces, tối đa 25MB mỗi tệp. Tệp
        <code>.md</code>, <code>.html</code>, <code>.txt</code> đọc được ngay
        trong app, không cần tải về.
      </p>
    </div>
  </div>
</div>
