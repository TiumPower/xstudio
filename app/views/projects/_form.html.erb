<%= form_with model: project, url: (project.persisted? ? project_path(project) : projects_path),
              local: true, class: "space-y-0",
              data: { controller: "project-type",
                      project_type_product_label_value: "Đối tượng khách hàng",
                      project_type_client_label_value: "Khách hàng",
                      project_type_product_placeholder_value: "Chuỗi bán lẻ vừa, 10–50 cửa hàng",
                      project_type_client_placeholder_value: "Coopmart · hợp đồng 3 giai đoạn" } do |f| %>
  <%= return_to_field if project.persisted? %>

  <% if project.errors.any? %>
    <div class="x-toast x-toast-bad mb-4">
      <div><%= project.errors.full_messages.to_sentence %></div>
    </div>
  <% end %>

  <%# Trường ngắn xếp 3 cột ở màn rộng để không có input dài cả mét. %>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-5">
    <div class="x-field md:col-span-2 xl:col-span-3">
      <%= f.label :name %>
      <%= f.text_field :name, class: "x-input", autofocus: true, placeholder: "Kho dữ liệu & Báo cáo bán lẻ" %>
    </div>

    <div class="x-field">
      <%= f.label :project_type %>
      <%= f.select :project_type,
                   Project.project_types.keys.map { |k| [t("project_types_long.#{k}"), k] },
                   {}, class: "x-select",
                   data: { project_type_target: "select", action: "change->project-type#sync" } %>
    </div>

    <div class="x-field">
      <%= f.label :code %>
      <%= f.text_field :code, class: "x-input x-mono", placeholder: "tự sinh (PRD-001 / DX-004)" %>
      <p class="x-hint">Để trống để hệ thống tự sinh theo loại hình.</p>
    </div>

    <%# Nhìn form trống thì không đoán được dự án Product khác gì — nói thẳng ra. %>
    <div class="md:col-span-2 xl:col-span-3 -mt-1 mb-4" data-project-type-target="productNote" hidden>
      <div class="x-toast">
        <div>
          Dự án <strong>Product</strong> là sản phẩm của chính đội. Sau khi tạo,
          dự án sẽ có thêm tab <strong>Sản phẩm</strong> để ghi mô tả, các
          <strong>liên kết</strong> (trang web, kho mã, bảng thiết kế),
          <strong>tài khoản truy cập</strong> từng dịch vụ và
          <strong>tài liệu</strong> (viết bằng Markdown/HTML hoặc tải tệp lên).
        </div>
      </div>
    </div>

    <div class="x-field md:col-span-2 xl:col-span-3">
      <%= f.label :description %>
      <%= f.text_area :description, class: "x-textarea", rows: 3, placeholder: "Phạm vi, mục tiêu, cách bàn giao…" %>
    </div>

    <div class="x-field">
      <%# Dự án Product là sản phẩm của đội, không có "khách hàng" — ô này
          mang nghĩa nhóm người dùng mà sản phẩm nhắm tới. %>
      <label data-project-type-target="clientLabel">
        <%= project.product? ? "Đối tượng khách hàng" : "Khách hàng" %>
      </label>
      <%= f.text_field :client_name, class: "x-input",
                       data: { project_type_target: "clientInput" },
                       placeholder: project.product? ? "Chuỗi bán lẻ vừa, 10–50 cửa hàng" : "Coopmart · hợp đồng 3 giai đoạn" %>
    </div>

    <div class="x-field">
      <%= f.label :status %>
      <%= f.select :status, Project.statuses.keys.map { |k| [t("project_statuses.#{k}"), k] }, {}, class: "x-select" %>
    </div>

    <div class="x-field">
      <%= f.label :start_date %>
      <%= f.date_field :start_date, class: "x-input" %>
    </div>

    <div class="x-field">
      <%= f.label :due_date %>
      <%= f.date_field :due_date, class: "x-input" %>
    </div>

    <div class="x-field">
      <%= f.label :owner_id, "Người phụ trách" %>
      <%= f.collection_select :owner_id, User.assignable, :id, :display_name, { include_blank: "— chọn —" }, class: "x-select" %>
    </div>

    <div class="x-field">
      <%= f.label :color %>
      <%= render "shared/color_picker", name: "project[color]",
                 value: (project.color.presence || project.type_color) %>
      <p class="x-hint">Mặc định theo loại hình dự án.</p>
    </div>

    <div class="x-field md:col-span-2 xl:col-span-3">
      <label>Thành viên tham gia</label>
      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-2 p-3 rounded-[10px] border" style="border-color:var(--line);background:var(--bg-2)">
        <%# Bỏ tích hết thì trình duyệt không gửi member_ids nào cả; ô rỗng này
            giữ cho khoá luôn có mặt, để controller phân biệt được "form này không
            đụng tới thành viên" với "form này bỏ hết thành viên". %>
        <%= hidden_field_tag "project[member_ids][]", "", id: nil %>
        <% User.assignable.each do |user| %>
          <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-white">
            <%= check_box_tag "project[member_ids][]", user.id, project.member?(user) || project.owner_id == user.id, class: "x-check", id: "member_#{user.id}" %>
            <%= avatar_for user, size: :sm %>
            <span class="text-[13px] truncate"><%= user.display_name %></span>
          </label>
        <% end %>
      </div>
      <p class="x-hint">Chỉ thành viên tham gia mới được gán công việc. Mọi người vẫn xem được dự án.</p>
    </div>

    <div class="x-field md:col-span-2 xl:col-span-3">
      <label>Tiến độ</label>
      <div class="flex flex-wrap items-center gap-4 p-3 rounded-[10px] border" style="border-color:var(--line);background:var(--bg-2)">
        <label class="flex items-center gap-2 text-[13px] cursor-pointer">
          <%= f.radio_button :progress_mode, "auto", class: "x-check" %> Tự động theo công việc hoàn thành
        </label>
        <label class="flex items-center gap-2 text-[13px] cursor-pointer">
          <%= f.radio_button :progress_mode, "manual", class: "x-check" %> Nhập tay
        </label>
        <div class="flex items-center gap-2">
          <%= f.number_field :manual_progress, min: 0, max: 100, class: "x-input w-[84px] h-9 text-center x-num" %>
          <span class="x-hint m-0">%</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2.5 pt-2">
    <%= f.submit(project.persisted? ? "Lưu thay đổi" : "Tạo dự án", class: "x-btn x-btn-primary cursor-pointer") %>
    <%= link_to "Huỷ", (project.persisted? ? return_to_path(project_path(project)) : projects_path), class: "x-btn x-btn-ghost" %>
  </div>
<% end %>
