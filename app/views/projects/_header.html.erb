<%
  income  = @project.income_total
  expense = @project.expense_total
  profit  = income - expense
%>
<% content_for :back_path, projects_path %>

<div class="space-y-3">
  <%# --- Danh tính dự án --------------------------------------------- %>
  <div class="x-card overflow-hidden">
    <div class="p-5">
      <%# Trên điện thoại xếp dọc: nút hành động xuống dưới để tiêu đề
          không bị bóp thành mỗi dòng một chữ. %>
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="x-code"><%= @project.code %></span>
            <%= project_type_chip(@project) %>
            <%= project_status_chip(@project) %>
            <% if @project.archived? %><span class="x-chip">Đã lưu trữ</span><% end %>
            <% if @project.overdue? %>
              <span class="x-chip x-chip-bad">Quá hạn <%= overdue_days(@project.due_date) %> ngày</span>
            <% end %>
          </div>

          <h1 class="x-h1 leading-tight mb-2.5 text-balance"><%= @project.name %></h1>

          <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-x-5 gap-y-1.5 text-[13px]" style="color:var(--ink-2)">
            <% if @project.client_name.present? %>
              <span class="inline-flex items-center gap-1.5">
                <span style="color:var(--ink-3)">Khách hàng</span>
                <strong style="color:var(--ink)"><%= @project.client_name %></strong>
              </span>
            <% end %>
            <span class="inline-flex items-center gap-1.5">
              <span style="color:var(--ink-3)">Phụ trách</span>
              <%= avatar_for @project.owner, size: :sm %>
              <strong style="color:var(--ink)"><%= @project.owner&.display_name || "—" %></strong>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span style="color:var(--ink-3)">Hạn</span>
              <strong class="x-num <%= 'x-out' if @project.overdue? %>" style="color:var(--ink)">
                <%= @project.due_date ? l(@project.due_date) : "chưa đặt" %>
              </strong>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span style="color:var(--ink-3)">Tham gia</span>
              <%= avatar_stack(@project.members, limit: 4) %>
            </span>
          </div>
        </div>

        <div class="flex items-center gap-2 flex-none order-first lg:order-none self-start">
          <div class="relative" data-controller="dropdown">
            <button class="x-btn x-btn-primary x-btn-sm" data-action="dropdown#toggle">+ Thêm mới</button>
            <div class="absolute right-0 mt-2 w-[196px] x-card p-1.5 z-50" hidden data-dropdown-target="menu">
              <%= link_to "Công việc mới", new_task_path(project_id: @project.id),
                          class: "block px-3 py-2 rounded-lg text-[13.5px] hover:bg-[var(--bg)]" %>
              <%= link_to "Giao dịch mới", new_transaction_path(project_id: @project.id),
                          class: "block px-3 py-2 rounded-lg text-[13.5px] hover:bg-[var(--bg)]",
                          data: { turbo_frame: "modal" } %>
            </div>
          </div>

          <%= link_to "Sửa", edit_project_path(@project), class: "x-btn x-btn-ghost x-btn-sm" %>

          <div class="relative" data-controller="dropdown">
            <button class="x-btn x-btn-ghost x-btn-icon" data-action="dropdown#toggle" aria-label="Thao tác khác">⋯</button>
            <div class="absolute right-0 mt-2 w-[196px] x-card p-1.5 z-50" hidden data-dropdown-target="menu">
              <% if @project.archived? %>
                <%= button_to "Bỏ lưu trữ", unarchive_project_path(@project), method: :patch,
                              class: "w-full text-left px-3 py-2 rounded-lg text-[13.5px] hover:bg-[var(--bg)]" %>
              <% else %>
                <%= button_to "Lưu trữ dự án", archive_project_path(@project), method: :patch,
                              class: "w-full text-left px-3 py-2 rounded-lg text-[13.5px] hover:bg-[var(--bg)]" %>
              <% end %>
              <% if current_user.role_admin? || @project.created_by_id == current_user.id %>
                <div class="x-divider my-1.5"></div>
                <%= button_to "Xoá dự án", project_path(@project), method: :delete,
                              form: { data: { turbo_confirm: "Xoá dự án #{@project.code}? Công việc và giao dịch sẽ bị ẩn theo." } },
                              class: "w-full text-left px-3 py-2 rounded-lg text-[13.5px] hover:bg-[var(--bad-soft)]", style: "color:var(--bad)" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# --- Chỉ số: tách hẳn khỏi phần danh tính bằng nền và viền ------- %>
    <div class="grid grid-cols-2 lg:grid-cols-4 border-t" style="border-color:var(--line-2);background:var(--bg-2)">
      <div class="px-4 sm:px-5 py-3 sm:py-3.5 border-r" style="border-color:var(--line-2)">
        <div class="x-eyebrow mb-1">Tiến độ</div>
        <div class="flex items-center gap-2.5">
          <span class="x-num text-[16px] sm:text-[19px] font-bold leading-none"><%= @project.progress %>%</span>
          <div class="x-progress flex-1 max-w-[80px]">
            <span style="width:<%= @project.progress %>%;background:<%= @project.type_color %>"></span>
          </div>
        </div>
      </div>
      <div class="px-4 sm:px-5 py-3 sm:py-3.5 border-r" style="border-color:var(--line-2)">
        <div class="x-eyebrow mb-1">Thu</div>
        <div class="x-money text-[14px] sm:text-[17px] x-in"><%= format_vnd(income) %></div>
      </div>
      <div class="px-4 sm:px-5 py-3 sm:py-3.5 lg:border-r border-t lg:border-t-0" style="border-color:var(--line-2)">
        <div class="x-eyebrow mb-1">Chi</div>
        <div class="x-money text-[14px] sm:text-[17px] x-out"><%= format_vnd(expense) %></div>
      </div>
      <div class="px-4 sm:px-5 py-3 sm:py-3.5 border-t lg:border-t-0" style="border-color:var(--line-2)">
        <div class="x-eyebrow mb-1">Lợi nhuận</div>
        <div class="x-money text-[15px] sm:text-[19px]" style="color:<%= profit.negative? ? 'var(--bad)' : 'var(--good)' %>">
          <%= format_vnd(profit, signed: true) %>
        </div>
      </div>
    </div>
  </div>

  <%# --- Điều hướng trong dự án -------------------------------------- %>
  <div class="x-card px-2 overflow-x-auto x-scroll-thin">
    <div class="x-tabs" style="border-bottom:0">
      <% [["Tổng quan", project_path(@project), "overview"],
          ["Công việc", project_tasks_path(@project), "tasks"],
          ["Kanban", project_board_path(@project), "kanban"],
          ["Thu chi", project_transactions_path(@project), "finance"],
          ["Thành viên", project_members_path(@project), "members"],
          ["Hoạt động", project_activities_path(@project), "activity"]].each do |label, path, key| %>
        <%= link_to label, path, class: ("is-active" if @tab == key) %>
      <% end %>
    </div>
  </div>
</div>
