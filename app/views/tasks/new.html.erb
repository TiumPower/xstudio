<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <%= render layout: "shared/modal",
               locals: { title: "Tạo công việc mới", width: "max-w-[680px]",
                         subtitle: "Mã công việc tự sinh theo mã dự án." } do %>
      <%= render "form" %>
    <% end %>
  <% end %>
<% else %>
  <% page_title "Công việc mới" %>
  <div>
    <%= render "shared/page_header", title: "Tạo công việc mới",
               subtitle: "Mã công việc tự sinh theo mã dự án." %>
    <div class="x-card"><div class="p-5"><%= render "form" %></div></div>
  </div>
<% end %>
