<div class="flex items-start gap-3" id="comment_<%= comment.id %>">
  <%= avatar_for comment.user %>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="font-semibold text-[13.5px]"><%= comment.user.display_name %></span>
      <span class="x-muted"><%= time_ago(comment.created_at) %></span>
      <% if comment.edited? %><span class="x-muted">· đã chỉnh sửa</span><% end %>
      <% if comment.user_id == current_user.id || current_user.role_admin? %>
        <%= button_to "Xoá", comment_path(comment), method: :delete,
                      form: { data: { turbo_confirm: "Xoá bình luận này?" }, class: "ml-auto" },
                      class: "text-[12px] hover:underline", style: "color:var(--ink-3)" %>
      <% end %>
    </div>
    <div class="rounded-[10px] px-3.5 py-2.5 text-[13.5px] leading-relaxed" style="background:var(--bg)">
      <%= simple_format(highlight_mentions(comment.body)) %>
    </div>
    <% if comment.files.attached? %>
      <div class="flex flex-wrap gap-1.5 mt-2">
        <% comment.files.each do |file| %>
          <%= link_to "📎 #{file.filename.to_s.truncate(28)}", rails_blob_path(file, disposition: "attachment"),
                      class: "x-chip x-chip-brand", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
