<%
  raw_max = [series.map { |r| [r[:income], r[:expense]].max }.max, 1].max
  unit    = raw_max >= 20_000_000_000 ? [1_000_000_000, "tỷ ₫"] : [1_000_000, "triệu ₫"]
  ticks   = 4
  # Làm tròn trần lên mốc "đẹp" để các vạch trục Y là số tròn.
  step    = 10**Math.log10(raw_max / unit[0].to_f / ticks).floor
  step    = [1, 2, 2.5, 5, 10].map { |m| m * step }.find { |v| v * ticks >= raw_max / unit[0].to_f } || step
  max     = (step * ticks * unit[0]).to_i
%>
<div class="flex items-start gap-3">
  <div class="flex-none w-[46px] text-right">
    <div class="x-muted text-[10.5px] mb-2">Đơn vị: <%= unit[1] %></div>
    <div class="relative h-[180px]">
      <% (0..ticks).reverse_each do |i| %>
        <div class="absolute right-0 text-[10.5px] x-num" style="color:var(--ink-2);top:<%= (ticks - i) * (180.0 / ticks) - 6 %>px">
          <%= (step * i) == (step * i).to_i ? (step * i).to_i : (step * i).round(1).to_s.sub(".", ",") %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex-1 min-w-0">
    <div class="x-muted text-[10.5px] mb-2 opacity-0">.</div>
    <div class="relative h-[180px]">
      <% (0..ticks).each do |i| %>
        <div class="absolute inset-x-0 border-t" style="border-color:var(--line-2);top:<%= i * (180.0 / ticks) %>px"></div>
      <% end %>
      <div class="absolute inset-0 flex items-end gap-[3px]">
        <% series.each do |row| %>
          <div class="flex-1 flex items-end justify-center gap-[2px] h-full group relative">
            <div class="w-[42%] rounded-t-[3px] transition-all" style="background:var(--brand);height:<%= (row[:income] * 100.0 / max).round(1) %>%"></div>
            <div class="w-[42%] rounded-t-[3px] transition-all" style="background:#E8A39E;height:<%= (row[:expense] * 100.0 / max).round(1) %>%"></div>
            <div class="absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 hidden group-hover:block z-10 whitespace-nowrap
                        px-2.5 py-1.5 rounded-lg text-[11px] text-white shadow-lg" style="background:var(--nav)">
              <div class="font-semibold mb-0.5"><%= row[:label] %></div>
              <div>Thu <%= format_vnd(row[:income]) %></div>
              <div>Chi <%= format_vnd(row[:expense]) %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="flex gap-[3px] mt-2">
      <% series.each_with_index do |row, i| %>
        <div class="flex-1 text-center text-[11px] x-num font-medium" style="color:var(--ink-2)">
          <%= i.zero? || row[:month].month == 1 ? row[:month].strftime("%m/%y") : row[:month].strftime("%m") %>
        </div>
      <% end %>
    </div>
    <div class="text-right text-[10.5px] mt-1" style="color:var(--ink-3)">tháng</div>
  </div>
</div>

<% last = series.last %>
<% if last %>
  <div class="flex gap-6 mt-4 pt-4 border-t text-[12.5px]" style="border-color:var(--line-2)">
    <div>
      <div style="color:var(--ink-3)">Thu trong tháng <%= l(last[:month], format: "%m/%Y") %></div>
      <div class="x-money x-in mt-0.5"><%= format_vnd(last[:income]) %></div>
    </div>
    <div>
      <div style="color:var(--ink-3)">Chi trong tháng <%= l(last[:month], format: "%m/%Y") %></div>
      <div class="x-money x-out mt-0.5"><%= format_vnd(last[:expense]) %></div>
    </div>
  </div>
<% end %>
