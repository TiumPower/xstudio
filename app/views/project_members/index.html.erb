<% page_title "Chi tiết dự án" %>
<%= render "projects/header" %>

<div class="mt-4 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-4 items-start">
  <div class="x-card overflow-hidden">
    <div class="x-card-head">
      <h2 class="x-h3 x-section-title">Thành viên tham gia</h2>
      <span class="x-muted"><%= @memberships.size %> người</span>
    </div>
    <table class="x-table">
      <thead><tr><th>Thành viên</th><th>Tham gia</th><th class="text-right">Việc đang mở</th><th></th></tr></thead>
      <tbody>
        <% @memberships.each do |membership| %>
          <% user = membership.user %>
          <tr>
            <td>
              <div class="flex items-center gap-2.5">
                <%= avatar_for user %>
                <div class="min-w-0">
                  <div class="font-semibold text-[13.5px] flex items-center gap-1.5">
                    <%= user.display_name %>
                    <% if user.id == @project.owner_id %><span class="x-chip x-chip-brand">Phụ trách</span><% end %>
                  </div>
                  <div class="x-muted truncate"><%= user.email %></div>
                </div>
              </div>
            </td>
            <td class="x-num" style="color:var(--ink-2)"><%= membership.joined_at ? l(membership.joined_at.to_date) : "—" %></td>
            <td class="x-td-num font-semibold"><%= @open_counts[user.id] || 0 %></td>
            <td class="text-right">
              <% unless user.id == @project.owner_id %>
                <%= button_to "Gỡ", project_project_membership_path(@project, membership), method: :delete,
                              form: { data: { turbo_confirm: "Gỡ #{user.display_name} khỏi dự án?" } },
                              class: "text-[12.5px] font-semibold hover:underline", style: "color:var(--bad)" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="x-card">
    <div class="x-card-head"><h2 class="x-h3 x-section-title">Thêm thành viên</h2></div>
    <div class="p-4">
      <% if @candidates.empty? %>
        <p class="x-muted">Tất cả thành viên đã tham gia dự án này.</p>
      <% else %>
        <%= form_with url: project_project_memberships_path(@project), method: :post do %>
          <div class="space-y-1 mb-3.5 max-h-[300px] overflow-auto x-scroll-thin">
            <% @candidates.each do |user| %>
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-[var(--bg)]">
                <%= check_box_tag "user_ids[]", user.id, false, class: "x-check", id: "cand_#{user.id}" %>
                <%= avatar_for user, size: :sm %>
                <span class="text-[13px] truncate"><%= user.display_name %></span>
              </label>
            <% end %>
          </div>
          <button class="x-btn x-btn-primary x-btn-sm x-btn-block">Thêm vào dự án</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
