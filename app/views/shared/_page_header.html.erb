<%# Phần đầu trang dùng chung: tên màn hình, một câu nói rõ nó là gì, và hành
    động chính nằm cố định bên phải. Nhờ vậy mọi trang mở ra đều đọc được ngay
    "đây là gì" và "làm gì tiếp". %>
<%# sm trở lên thì KHÔNG xuống dòng: phụ đề dài mà cho wrap thì khối hành
    động rơi xuống dòng dưới và dạt về bên trái. %>
<div class="flex flex-wrap sm:flex-nowrap items-start justify-between gap-3 mb-4">
  <div class="min-w-0">
    <h1 class="x-h1 leading-tight"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="x-sub mt-1 max-w-[70ch]"><%= subtitle %></p>
    <% end %>
  </div>
  <% if local_assigns[:actions].present? %>
    <div class="flex items-center gap-2 flex-none ml-auto"><%= actions %></div>
  <% end %>
</div>
