<%# Khung popup dùng chung. Gọi trong một turbo_frame_tag "modal". %>
<div class="x-overlay" data-controller="modal" data-action="click->modal#backdrop">
  <div class="absolute inset-0 grid place-items-center p-4">
    <div class="x-modal <%= local_assigns[:width] || 'max-w-[760px]' %>">
      <div class="x-card-head sticky top-0 bg-white z-10">
        <div>
          <h2 class="x-h3"><%= title %></h2>
          <% if local_assigns[:subtitle].present? %>
            <p class="x-muted mt-0.5"><%= subtitle %></p>
          <% end %>
        </div>
        <%= render "shared/close_button", action: "modal#close" %>
      </div>
      <div class="p-5"><%= yield %></div>
    </div>
  </div>
</div>
