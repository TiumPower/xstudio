<%= link_to project_path(project), class: "x-card p-4 block hover:shadow-md transition relative overflow-hidden" do %>
  <span class="absolute left-0 top-4 bottom-4 w-[3px] rounded-r" style="background:<%= project.type_color %>"></span>

  <div class="pl-3">
    <div class="flex items-start justify-between gap-2 mb-1.5">
      <span class="x-code"><%= project.code %></span>
      <%= project_status_chip(project) %>
    </div>

    <h3 class="x-h3 mb-1 x-clamp-2 leading-snug"><%= project.name %></h3>
    <p class="x-muted mb-3.5 x-clamp-1"><%= project.client_name.presence || project.type_label %></p>

    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[12px]" style="color:var(--ink-3)">Tiến độ</span>
      <span class="x-num text-[12.5px] font-semibold"><%= project.progress %>%</span>
    </div>
    <div class="x-progress mb-3.5"><span style="width:<%= project.progress %>%;background:<%= project.type_color %>"></span></div>

    <div class="grid grid-cols-2 gap-2 mb-3.5">
      <div class="rounded-[10px] px-3 py-2" style="background:var(--bg)">
        <div class="text-[11px] mb-0.5" style="color:var(--ink-3)">Thu</div>
        <div class="x-money text-[12.5px] x-in"><%= format_vnd(totals[:income]) %></div>
      </div>
      <div class="rounded-[10px] px-3 py-2" style="background:var(--bg)">
        <div class="text-[11px] mb-0.5" style="color:var(--ink-3)">Chi</div>
        <div class="x-money text-[12.5px] x-out"><%= format_vnd(totals[:expense]) %></div>
      </div>
    </div>

    <div class="flex items-center justify-between gap-2">
      <%= avatar_stack(project.members, limit: 3) %>
      <div class="flex items-center gap-2.5">
        <% if project.due_date %>
          <span class="x-num text-[12px] <%= 'x-chip x-chip-bad' if project.overdue? %>"
                style="<%= 'color:var(--ink-2)' unless project.overdue? %>"><%= l(project.due_date) %></span>
        <% end %>
        <span class="x-muted"><%= project.tasks.kept.size %> việc</span>
      </div>
    </div>
  </div>
<% end %>
