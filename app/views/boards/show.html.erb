<% page_title "Chi tiết dự án" %>
<%= render "projects/header" %>

<div class="mt-4 space-y-3.5">
  <%= form_with url: project_board_path(@project), method: :get, class: "flex flex-wrap items-center gap-2" do %>
    <%= select_tag :assignee_id, options_from_collection_for_select(@project.members, :id, :display_name, params[:assignee_id]),
                   include_blank: "Người thực hiện", class: "x-select h-9 w-auto text-[13px]", onchange: "this.form.requestSubmit()" %>
    <%= select_tag :priority, options_for_select(Task.priorities.keys.map { |k| [t("priorities.#{k}"), k] }, params[:priority]),
                   include_blank: "Độ ưu tiên", class: "x-select h-9 w-auto text-[13px]", onchange: "this.form.requestSubmit()" %>
    <% if @labels.any? %>
      <%= select_tag :label_id, options_from_collection_for_select(@labels, :id, :name, params[:label_id]),
                     include_blank: "Nhãn", class: "x-select h-9 w-auto text-[13px]", onchange: "this.form.requestSubmit()" %>
    <% end %>
    <%= select_tag :due, options_for_select([["Quá hạn", "overdue"], ["Tuần này", "this_week"], ["Không hạn", "none"]], params[:due]),
                   include_blank: "Hạn", class: "x-select h-9 w-auto text-[13px]", onchange: "this.form.requestSubmit()" %>
    <% if params.values_at(:assignee_id, :priority, :label_id, :due).any?(&:present?) %>
      <%= link_to "Xoá lọc", project_board_path(@project), class: "x-btn x-btn-ghost x-btn-sm" %>
    <% end %>
    <div class="ml-auto flex items-center gap-2">
      <span class="x-muted hidden lg:block">Kéo–thả thẻ để đổi cột · lưu ngay</span>

      <%# Quản lý cột nằm sau nút bánh răng để bảng gọn gàng. %>
      <div class="relative" data-controller="dropdown">
        <button type="button" class="x-btn x-btn-ghost x-btn-icon" data-action="dropdown#toggle"
                aria-label="Quản lý cột" title="Quản lý cột">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor"
               stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="9" r="2.6"/>
            <path d="M9 1.5v2M9 14.5v2M16.5 9h-2M3.5 9h-2M14.3 3.7l-1.4 1.4M5.1 12.9l-1.4 1.4M14.3 14.3l-1.4-1.4M5.1 5.1L3.7 3.7"/>
          </svg>
        </button>
        <div class="absolute right-0 mt-2 w-[280px] x-card p-4 z-50" hidden data-dropdown-target="menu">
          <h3 class="text-[13px] font-semibold mb-1">Quản lý cột</h3>
          <p class="x-hint mb-3">Rê chuột vào đầu cột để thấy tay nắm kéo đổi thứ tự. Bấm ⋯ trên mỗi cột để đổi tên, màu hoặc giới hạn WIP.</p>
          <%= form_with url: project_board_columns_path(@project), method: :post do %>
            <label class="x-label block mb-1.5">Thêm cột mới</label>
            <input type="text" name="board_column[name]" placeholder="Tên cột" class="x-input h-9 text-[13px] mb-2" required>
            <label class="x-label block mb-1.5">Màu</label>
            <%= render "shared/color_picker", name: "board_column[color]", value: "#5A6B82" %>
            <button class="x-btn x-btn-primary x-btn-sm x-btn-block mt-2.5">Thêm cột</button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="x-board x-scroll-thin" data-controller="kanban" data-kanban-target="board"
       data-kanban-move-url-value="<%= move_task_path(code: "__CODE__") %>"
       data-kanban-reorder-url-value="<%= reorder_project_board_columns_path(@project) %>">
    <% @columns.each do |column| %>
      <%= render "column", column: column, tasks: (@tasks_by_column[column.id] || []) %>
    <% end %>

  </div>
</div>
