<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0B1C33">

<%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
<%= favicon_link_tag "favicon.svg", rel: "apple-touch-icon", type: "image/svg+xml" %>
<title><%= content_for(:title).presence || "#{current_workspace.name} · Xstudio" %></title>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">

<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%# actiontext.css kéo theo trix.css — thiếu nó thanh công cụ soạn thảo
    hiện thành một dòng chữ trần. %>
<%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
