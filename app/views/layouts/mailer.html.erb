<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
  </head>
  <body style="margin:0;padding:0;background:#F4F6FA;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0D1B2E;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F4F6FA;padding:28px 12px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border-radius:14px;overflow:hidden;box-shadow:0 1px 3px rgba(13,27,46,.08);">
          <tr>
            <td style="background:#0B1C33;padding:20px 26px;">
              <table role="presentation" cellpadding="0" cellspacing="0"><tr>
                <td style="padding-right:11px;">
                  <%# Email client hay chặn ảnh ngoài, nên vẽ luôn bằng bảng
                      thay vì nhúng ảnh — không có ảnh vẫn ra hình. %>
                  <div style="width:32px;height:32px;border-radius:9px;background:#2E6BC0;color:#fff;font-weight:700;font-size:16px;text-align:center;line-height:32px;letter-spacing:-.5px;">X</div>
                </td>
                <td>
                  <div style="color:#fff;font-weight:700;font-size:15px;"><%= @workspace.name %></div>
                  <div style="color:#6B87AC;font-size:12px;"><%= @workspace.tagline.presence || "Xstudio" %></div>
                </td>
              </tr></table>
            </td>
          </tr>
          <tr><td style="padding:28px 26px 24px;"><%= yield %></td></tr>
          <tr>
            <td style="padding:16px 26px 22px;border-top:1px solid #EEF1F6;color:#8A98AC;font-size:11.5px;line-height:1.6;">
              Email tự động từ <%= @workspace.name %>.
              <a href="https://<%= ENV.fetch('APP_HOST', 'xstudio.tiumpower.com') %>/ho-so" style="color:#2E6BC0;">Tắt loại thông báo này</a> trong Hồ sơ cá nhân.
            </td>
          </tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
